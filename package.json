{
  "name": "bandwithme",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --localhost",
    "start:tunnel": "EXPO_TUNNEL_SUBDOMAIN=davidjbng-bandwithme expo start --dev-client --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:design-demo": "node --test scripts/design-demo.test.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@auth/core": "0.41.2",
    "@convex-dev/auth": "^0.0.94",
    "@expo/dom-webview": "~58.0.2",
    "@expo/ui": "~58.0.28",
    "convex": "^1.42.1",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "~19.3.0",
    "convex-test": "^0.0.54",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "serve": "^14.2.6",
    "taze": "^19.14.1",
    "typescript": "~7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.11.0",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
