{
  "name": "bandwithme",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client --localhost",
    "start:tunnel": "EXPO_TUNNEL_SUBDOMAIN=davidjbng-bandwithme expo start --dev-client --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:export": "expo export --platform web",
    "typecheck": "vp check --no-fmt --no-lint",
    "test": "vp test run",
    "test:design-demo": "vp test run scripts/design-demo.test.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check --deny-warnings",
    "e2e:smoke": "playwright test --config playwright.smoke.config.ts",
    "version-packages": "changeset version && node scripts/release-metadata.mjs --sync",
    "test:release": "vp test run scripts/release-metadata.test.mjs"
  },
  "dependencies": {
    "@convex-dev/auth": "^2.0.0",
    "@convex-dev/rate-limiter": "0.4.3",
    "@convex-dev/resend": "^0.2.10",
    "@expo/dom-webview": "~58.0.2",
    "@expo/ui": "~58.0.28",
    "convex": "^1.50.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-speech-recognition": "58.0.1",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-ease": "0.10.0",
    "react-native-gesture-handler": "3.5.0",
    "react-native-keyboard-controller": "1.23.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-skia": "3.10.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "convex-test": "^0.0.71",
    "eas-cli": "27.10.0",
    "jsdom": "^31.0.1",
    "lefthook": "^2.2.2",
    "serve": "^14.2.8",
    "typescript": "~7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
    "vite-plus": "1.6.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
